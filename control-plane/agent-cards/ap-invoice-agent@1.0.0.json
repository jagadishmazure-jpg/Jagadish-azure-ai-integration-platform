      "id": "extract",
      "inputModes": [
        "application/json"
      ],
      "name": "Extract",
      "outputModes": [
        "application/json"
      ],
      "tags": [
        "read"
      ]
    },
    {
      "description": "Route an invoice: auto, review or reject. [side-effect: read]",
      "id": "classify",
      "inputModes": [
        "application/json"
      ],
      "name": "Classify",
      "outputModes": [
        "application/json"
      ],
      "tags": [
        "read"
      ]
    },
    {
      "description": "Draft a vendor or approver note from structured facts. [side-effect: read]",
      "id": "draft",
      "inputModes": [
        "application/json"
      ],
      "name": "Draft note",
      "outputModes": [
        "application/json"
      ],
      "tags": [
        "read"
      ]
    }
  ],
  "supportedInterfaces": [
    {
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0",
      "url": "http://agent-ap-invoice.inproc/a2a"
    }
  ],
  "version": "1.0.0"
}
