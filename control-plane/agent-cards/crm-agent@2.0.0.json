          },
          "sla": {
            "availability": "99.5%",
            "p95_ms": 1500.0
          },
          "system_of_record": "salesforce, dataverse",
          "version": "2.0.0"
        },
        "uri": "urn:aiip:integration-contract:v1"
      }
    ],
    "streaming": false
  },
  "defaultInputModes": [
    "application/json"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "description": "v2 contract: `customer` object replaces `account_number`. Published alongside v1 during migration.",
  "name": "CRM agent",
  "provider": {
    "organization": "AI Integration Platform (demo)",
    "url": "https://github.com/jagadishmazure-jpg"
  },
  "skills": [
    {
      "description": "Account plus open cases (v2 input shape). [side-effect: read]",
      "id": "account_summary",
