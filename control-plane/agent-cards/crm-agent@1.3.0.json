{
  "capabilities": {
    "extensions": [
      {
        "description": "Integration contract: owner, SLA, side effects, callers, schemas, eval score",
        "params": {
          "agent_id": "crm-agent",
          "allowed_callers": [
            "care-planner"
          ],
          "eval_score": 1.0,
          "identity_mode": "obo",
          "owner": "Jagadish Meduri (integration engineering)",
          "requires_headers": [
            "authorization",
            "traceparent",
            "x-tenant-id",
            "A2A-Version"
          ],
          "side_effect_class": "commit",
          "skills": {
            "account_summary": {
              "hitl": false,
              "input_schema": {
                "additionalProperties": false,
                "properties": {
                  "account_number": {
                    "pattern": "^ACC-[0-9]{4}$",
                    "type": "string"
                  }
                },
                "required": [
                  "account_number"
                ],
                "type": "object"
              },
              "side_effect": "read"
            },
            "open_case": {
              "hitl": false,
              "input_schema": {
                "additionalProperties": false,
                "properties": {
                  "account_number": {
                    "pattern": "^ACC-[0-9]{4}$",
                    "type": "string"
                  },
                  "idempotency_key": {
                    "maxLength": 80.0,
                    "minLength": 8.0,
                    "type": "string"
                  },
                  "priority": {
                    "enum": [
                      "Low",
                      "Medium",
                      "High"
                    ]
                  },
                  "subject": {
                    "maxLength": 200.0,
                    "type": "string"
                  }
                },
                "required": [
                  "account_number",
                  "subject"
                ],
                "type": "object"
              },
              "side_effect": "commit"
            }
          },
          "sla": {
            "availability": "99.5%",
            "p95_ms": 1500.0
          },
          "system_of_record": "salesforce, dataverse",
          "version": "1.3.0"
        },
        "uri": "urn:aiip:integration-contract:v1"
      }
    ],
    "streaming": false
  },
  "defaultInputModes": [
    "application/json"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "description": "Owns the customer object model in the CRM (Salesforce stand-in). Always acts as the user.",
  "name": "CRM agent",
  "provider": {
    "organization": "AI Integration Platform (demo)",
    "url": "https://github.com/jagadishmazure-jpg"
  },
  "skills": [
    {
      "description": "Account plus open cases, trimmed by the user's sharing rules. [side-effect: read]",
      "id": "account_summary",
      "inputModes": [
        "application/json"
      ],
      "name": "Account summary",
      "outputModes": [
        "application/json"
      ],
      "tags": [
        "read"
      ]
    },
    {
      "description": "Create or update a CRM case (idempotent on the caller's key). [side-effect: commit]",
      "id": "open_case",
      "inputModes": [
        "application/json"
      ],
      "name": "Open case",
      "outputModes": [
        "application/json"
      ],
      "tags": [
        "commit"
      ]
    }
  ],
  "supportedInterfaces": [
    {
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0",
      "url": "http://agent-crm.inproc/a2a"
    }
  ],
  "version": "1.3.0"
}
