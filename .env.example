# Copy to .env only if you need to override defaults. Nothing here is a secret: vendor
# credentials are Key Vault references (kv://...) inside the code, never environment values.

# local (default): local token issuer, in-memory kv:// store, in-memory bus, sandbox stand-ins.
# azure: MSAL + managed identity, Key Vault, Service Bus / Event Grid, Foundry model.
AIIP_MODE=local

# --- Azure mode only (set by azd from Bicep outputs) ---------------------------------------
# AIIP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# AIIP_ALLOWED_TENANTS=00000000-0000-0000-0000-000000000000
# AIIP_KEYVAULT_NAME=kv-aiip-xxxx
# AIIP_SERVICEBUS_NAMESPACE=sb-aiip-xxxx.servicebus.windows.net
# AIIP_EVENTGRID_TOPIC_ENDPOINT=https://egt-aiip-xxxx.<region>-1.eventgrid.azure.net/api/events
# AIIP_IDENTITY_URL=https://<identity-gateway-fqdn>
# AIIP_TOOL_GATEWAY_URL=https://<tool-gateway-fqdn>
# AIIP_IDENTITY_GATEWAY_MI_CLIENT_ID=<client id of the identity gateway's managed identity>
# AIIP_WORKLOAD_REGISTRATION=<which app registration this container runs as, e.g. crm-agent>
# AIIP_MI_PRINCIPALS=<principalId>=<registration>,...
# One per workload, the real Entra application (client) id:
# AIIP_APPID_CRM_AGENT=<guid>
# APPLICATIONINSIGHTS_CONNECTION_STRING=<from azd env>
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=gpt-5-mini

# --- Point a connector pack at a real vendor sandbox (default: the local stand-ins) ---------
# AIIP_SAAS_SALESFORCE_URL=https://<your-sandbox>.my.salesforce.com
# AIIP_SAAS_SERVICENOW_URL=https://<your-pdi>.service-now.com

# --- Tuning (defaults shown) ------------------------------------------------------------
# AIIP_TENANT_RPS=20
# AIIP_TENANT_BURST=40
# AIIP_BREAKER_FAILURES=3
# AIIP_BREAKER_RESET_S=15
